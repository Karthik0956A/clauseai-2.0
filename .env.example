# Copy to .env. Do not commit real values.

MONGODB_URI=
AUTH_SECRET=

# LLM gateway. OpenRouter is not an AI technique; it routes to OPENROUTER_MODEL.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Embeddings are a separate model from the chat model.
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# Vector database. Leave blank until a Qdrant instance is available.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=clauseai_chunks

# Server-side only. The browser keeps calling Next.js /api routes.
FASTAPI_URL=http://127.0.0.1:8000
